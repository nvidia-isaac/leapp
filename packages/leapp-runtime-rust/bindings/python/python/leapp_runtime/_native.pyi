from os import PathLike
from typing import Any, final
from collections.abc import Mapping

import numpy as np

class BundleError(Exception):
    code: int
    phase: str
    message: str
    path: PathLike[str]

class RuntimeError(Exception):
    code: int
    phase: str
    message: str

class PortRef:
    @property
    def node(self) -> str: ...

    @property
    def port(self) -> str: ...

    def name(self) -> str: ...

class PortSpec:
    @property
    def name(self) -> str: ...

    @property
    def dtype(self) -> str: ...

    @property
    def shape(self) -> list[int]: ...

    @property
    def tensor_type(self) -> str: ...

    @property
    def metadata(self) -> dict[str, Any]: ...

class MetadataMapping:
    @property
    def entries(self) -> list[tuple[Any, Any]]: ...

class Bundle:
    @staticmethod
    def open(path: str | PathLike[str]) -> Bundle: ...

    def yaml_path(self) -> PathLike[str]: ...

    def model_names(self) -> list[str]: ...

    def model_io(self, model_name: str) -> tuple[list[str], list[str]] | None: ...

    def pipeline_inputs(self) -> dict[str, PortSpec | None]: ...

    def pipeline_outputs(self) -> dict[str, PortSpec | None]: ...

    def pipeline_configs(self) -> dict[str, Any]: ...

    def pipeline_metadata(self) -> dict[str, Any]: ...

    def metadata(self) -> dict[str, Any]: ...

    def system_information(self) -> dict[str, Any]: ...

    def model_parameters(self, node: str) -> dict[str, Any] | None: ...

    def model_metadata(self, node: str) -> dict[str, Any] | None: ...

    def input_info(self, node: str, port: str) -> PortSpec | None: ...

    def output_info(self, node: str, port: str) -> PortSpec | None: ...

@final
class Runtime:
    @staticmethod
    def open(bundle: Bundle, options: Any = None) -> Runtime: ...
    def info(self) -> Bundle: ...
    def create_session(self) -> Session: ...
    def close(self) -> None: ...
    def __enter__(self) -> Runtime: ...
    def __exit__(self, exc_type: object, exc: object, traceback: object) -> None: ...

class Session:
    def run(
        self,
        inputs: Mapping[str, Any],
        *,
        output_device: str = "cpu",
        output_overrides: Mapping[str, str] | None = None,
    ) -> RunResult: ...
    def reset(self) -> None: ...

class RunResult:
    def __getitem__(self, name: str) -> Tensor: ...
    def __len__(self) -> int: ...
    def keys(self) -> tuple[str, ...]: ...
    def numpy(self, name: str) -> np.ndarray: ...

class Tensor:
    @property
    def dtype(self) -> str: ...
    @property
    def shape(self) -> tuple[int, ...]: ...
    @property
    def device(self) -> str: ...
    def numpy(self) -> np.ndarray: ...
    def dlpack_view(self) -> DLPackView: ...
    def __dlpack_device__(self) -> tuple[int, int]: ...
    def __dlpack__(
        self,
        *,
        stream: int | None = None,
        max_version: tuple[int, int] | None = None,
        dl_device: tuple[int, int] | None = None,
        copy: bool | None = None,
    ) -> Any: ...

class DLPackView:
    def __dlpack_device__(self) -> tuple[int, int]: ...
    def __dlpack__(
        self,
        *,
        stream: int | None = None,
        max_version: tuple[int, int] | None = None,
        dl_device: tuple[int, int] | None = None,
        copy: bool | None = None,
    ) -> Any: ...
