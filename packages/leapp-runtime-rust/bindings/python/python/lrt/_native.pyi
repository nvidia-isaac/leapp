from os import PathLike
from typing import Any

class BundleError(Exception):
    code: int
    phase: str
    message: str
    path: PathLike[str]

class PortRef:
    @property
    def node(self) -> str: ...
    @property
    def port(self) -> str: ...
    def name(self) -> str: ...

class PortSpec:
    @property
    def name(self) -> str: ...
    @property
    def dtype(self) -> str: ...
    @property
    def shape(self) -> list[int]: ...
    @property
    def tensor_type(self) -> str: ...
    @property
    def metadata(self) -> dict[str, Any]: ...

class MetadataMapping:
    @property
    def entries(self) -> list[tuple[Any, Any]]: ...

class Bundle:
    @staticmethod
    def open(path: str | PathLike[str]) -> Bundle: ...
    def yaml_path(self) -> PathLike[str]: ...
    def model_names(self) -> list[str]: ...
    def model_io(self, model_name: str) -> tuple[list[str], list[str]] | None: ...
    def pipeline_inputs(self) -> dict[str, PortSpec | None]: ...
    def pipeline_outputs(self) -> dict[str, PortSpec | None]: ...
    def pipeline_configs(self) -> dict[str, Any]: ...
    def pipeline_metadata(self) -> dict[str, Any]: ...
    def metadata(self) -> dict[str, Any]: ...
    def system_information(self) -> dict[str, Any]: ...
    def model_parameters(self, node: str) -> dict[str, Any] | None: ...
    def model_metadata(self, node: str) -> dict[str, Any] | None: ...
    def input_info(self, node: str, port: str) -> PortSpec | None: ...
    def output_info(self, node: str, port: str) -> PortSpec | None: ...
