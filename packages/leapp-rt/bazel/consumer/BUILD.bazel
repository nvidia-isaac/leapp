load("@leapp_rt//bazel:defs.bzl", "native_backend_plugin")
load("@rules_cc//cc:defs.bzl", "cc_test")
load("@rules_rust//rust:defs.bzl", "rust_test")

rust_test(
    name = "rust_test",
    srcs = ["runtime_test.rs"],
    edition = "2021",
    deps = ["@leapp_rt//:lrt"],
)

# The adapter must use the plugin's STL ABI, even when the consumer uses ABI 1.
native_backend_plugin(
    name = "libleapp_example.so",
    srcs = ["plugin.cc"],
    copts = [
        "-D_GLIBCXX_USE_CXX11_ABI=0",
        "-fvisibility=hidden",
    ],
    linkopts = ["-Wl,--no-undefined"],
)

cc_test(
    name = "cxx_test",
    srcs = ["runtime_test.cc"],
    args = ["$(rootpath :libleapp_example.so)"],
    copts = [
        "-std=c++20",
        "-fno-exceptions",
    ],
    data = [":libleapp_example.so"],
    linkopts = ["-ldl"],
    deps = ["@leapp_rt//:runtime"],
)
