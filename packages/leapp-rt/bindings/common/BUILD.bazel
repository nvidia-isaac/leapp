load("@leapp_crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "common",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "leapp_rt_bindings",
    edition = "2021",
    visibility = ["//bindings/cxx:__pkg__"],
    deps = ["//:lrt"],
)

rust_test(
    name = "lifecycle_test",
    srcs = [
        "src/session.rs",
        "tests/lifecycle.rs",
    ],
    crate_root = "tests/lifecycle.rs",
    edition = "2021",
    deps = ["//:lrt"] + all_crate_deps(normal_dev = True),
)
